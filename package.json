{
  "name": "coleccion-web-pdf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Extensión Chromium para recopilar múltiples vistas web y exportarlas como PDF.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suggus1899/page_to_pdf.git"
  },
  "bugs": {
    "url": "https://github.com/Suggus1899/page_to_pdf/issues"
  },
  "homepage": "https://github.com/Suggus1899/page_to_pdf#readme",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "idb": "8.0.3",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.2.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.10.1",
    "@types/pdfmake": "0.2.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
